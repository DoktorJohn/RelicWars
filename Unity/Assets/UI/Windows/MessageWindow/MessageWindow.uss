/* Assets/UI/Windows/MessageWindow/MessageWindow.uss */

.message-content {
    flex-direction: row;
    flex-grow: 1;
    padding: 10px;
}

.conversation-list-panel {
    width: 30%;
    border-right-width: 2px;
    border-right-color: var(--c-border);
    background-color: rgba(0, 0, 0, 0.05);
    margin-right: 10px;
    padding-right: 5px;
}

.message-area-panel {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
}

.message-scroll-view {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    margin-bottom: 10px;
    padding: 10px;
}

.input-area {
    flex-direction: row;
    height: 50px;
    align-items: center;
}

.message-input {
    flex-grow: 1;
    margin-right: 10px;
}

.send-button {
    width: 80px;
    height: 40px;
    margin-top: 0; /* Override global button margin */
}

/* Conversation Item */
.conversation-item {
    min-height: 55px;
    padding: 5px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
    flex-direction: column;
    justify-content: center;
    overflow: hidden; /* Fix: Prevent internal scrollbars */
}

.conversation-item:hover {
    background-color: rgba(165, 125, 50, 0.2);
}

.conversation-item.selected {
    background-color: rgba(165, 125, 50, 0.4);
}

.conversation-name {
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--c-text-header);
    margin: 0;
    padding: 0;
}

.conversation-last-msg {
    font-size: 12px;
    color: var(--c-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

/* Messages */
.message-bubble {
    padding: 10px;
    margin-bottom: 5px;
    border-radius: 8px;
    max-width: 80%;
    -unity-font-definition: var(--font-body);
    font-size: 14px;
    white-space: normal;
}

.message-bubble.mine {
    background-color: rgb(200, 220, 200); /* Light green tint */
    align-self: flex-end;
    border-bottom-right-radius: 0;
}

.message-bubble.theirs {
    background-color: rgb(230, 230, 230); /* Light grey */
    align-self: flex-start;
    border-bottom-left-radius: 0;
}

.new-conversation-btn {
    margin-bottom: 5px;
    height: 30px;
    font-size: 12px;
}

.recipient-label {
    width: 60px; /* Fixed width for alignment */
    -unity-font-style: bold;
    color: var(--c-text-body);
}

/* Header & Inputs */
.active-conversation-header {
    height: 30px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    margin-bottom: 5px;
    justify-content: center;
}

.conversation-title-label {
    -unity-font-style: bold;
    color: var(--c-text-header);
    font-size: 14px;
}

.new-message-header {
    flex-direction: column;
    height: 80px;
    margin-bottom: 5px;
    justify-content: center;
    overflow: visible; 
}

.recipient-row {
    flex-direction: row; 
    height: 35px; 
    align-items: center; 
    margin-bottom: 5px;
    position: relative; 
    overflow: visible;
}

.subject-row {
    flex-direction: row; 
    height: 35px; 
    align-items: center;
    position: relative; 
}

.recipient-input-container {
    flex-grow: 1;
    position: relative;
    overflow: visible; 
}

.recipient-input-field {
    flex-grow: 1;
}

/* Suggestion List */
.suggestion-list-container {
    position: absolute;
    top: 38px; /* Aligns just under the first row (approx 35px height + margins) */
    left: 60px; /* Matches the label width to align with input field */
    right: 0;
    background-color: rgb(30, 30, 30);
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 4px;
    max-height: 200px;
    overflow: hidden;
    padding: 2px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

.suggestion-item {
    padding: 8px 12px;
    color: white; /* Always white text */
    font-size: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    background-color: transparent;
    transition: background-color 0.1s;
}

.suggestion-item:hover {
    background-color: rgba(165, 125, 50, 0.4); /* Darker gold for hover */
    color: white; /* Ensure text remains white */
}

.suggestion-item.selected {
    background-color: black;
    color: white;
    -unity-font-style: bold;
}
