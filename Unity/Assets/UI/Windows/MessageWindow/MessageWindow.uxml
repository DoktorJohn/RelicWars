<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="MessageWindow.uss" />
    
    <ui:VisualElement name="Overlay" class="screen-overlay" picking-mode="Ignore">
        <ui:VisualElement name="WindowFrame" class="window-frame message-window-size">
            <!-- Header -->
            <ui:VisualElement name="Header" class="window-header">
                <ui:Label text="INBOX" class="window-header-label" />
                <ui:Button name="Inbox-Close-Button" text="X" class="window-close-btn" />
            </ui:VisualElement>
            
            <!-- Content -->
            <ui:VisualElement name="MessageContent" class="message-content">
                <!-- Left: Conversations -->
                <ui:VisualElement name="ConversationListPanel" class="conversation-list-panel">
                    <ui:Button name="NewConversationButton" text="+ NEW MESSAGE" class="btn-global-base btn-imperial-primary new-conversation-btn" />
                    <ui:ScrollView name="ConversationList" />
                </ui:VisualElement>
                
                <!-- Right: Messages -->
                <ui:VisualElement name="MessageArea" class="message-area-panel">
                    <!-- Title Bar for active conversation -->
                    <ui:VisualElement name="ActiveConversationHeader" class="active-conversation-header">
                        <ui:Label name="ConversationTitle" text="" class="conversation-title-label" />
                        <ui:Button name="DeleteConversationButton" text="DELETE" class="delete-conversation-button" />
                    </ui:VisualElement>

                    <!-- New Conversation Header (Hidden by default) -->
                    <ui:VisualElement name="NewMessageHeader" class="new-message-header">
                        <ui:VisualElement class="recipient-row">
                            <ui:Label text="To:" class="recipient-label" />
                            <ui:VisualElement class="recipient-input-container">
                                <ui:VisualElement name="RecipientChips" class="recipient-chip-container" />
                                <ui:TextField name="RecipientInput" class="game-input compose-input-field recipient-input-field" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView name="SuggestionList" class="suggestion-list-container" style="display: none;" />
                        <ui:VisualElement class="subject-row">
                            <ui:Label text="Subject:" class="recipient-label" />
                            <ui:TextField name="SubjectInput" class="game-input compose-input-field recipient-input-field" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:ScrollView name="MessageList" class="message-scroll-view" />
                    
                    <ui:VisualElement name="InputArea" class="input-area">
                        <ui:VisualElement class="message-composer">
                            <ui:VisualElement name="ReportPickerBar" class="report-picker-bar">
                                <ui:Button name="ReportPickerButton" text="ATTACH REPORT" class="btn-global-base btn-imperial-primary report-picker-button" />
                                <ui:Label name="SelectedReportLabel" text="" class="selected-report-label" />
                                <ui:Button name="RemoveReportButton" text="REMOVE" class="report-picker-remove" />
                            </ui:VisualElement>
                            <ui:ScrollView name="ReportPickerList" class="report-picker-list" style="display: none;" />
                            <ui:TextField name="MessageInput" class="game-input message-input" />
                        </ui:VisualElement>
                        <ui:Button name="SendButton" text="SEND" class="btn-global-base btn-imperial-success send-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
