<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Windows/BarracksWindow/BarracksWindow.uss" />

    <ui:VisualElement name="Stable-Window-Overlay" picking-mode="Ignore" class="screen-overlay">
        <ui:VisualElement name="Stable-Window-MainContainer" class="window-frame size-large">

            <ui:VisualElement name="Stable-Window-Header" class="window-header">
                <ui:Label class="window-header-label" text="STABLE" />
                <ui:Button name="Header-Close-Button" class="window-close-btn" text="x" />
            </ui:VisualElement>

            <ui:VisualElement class="window-body">

                <!-- SELECT UNIT TYPE -->
                <ui:Label text="SELECT UNIT TYPE" class="section-label" />
                <ui:VisualElement class="tabs-wrapper">
                    <ui:ScrollView
                        name="Tabs-Scroll-Container"
                        mode="Horizontal"
                        horizontal-scroller-visibility="Auto"
                        vertical-scroller-visibility="Hidden"
                        class="tabs-scroll-view" />
                </ui:VisualElement>

                <ui:VisualElement class="divider" />

                <!-- DETAIL VIEW -->
                <ui:VisualElement name="Detail-View-Container" class="detail-container">

                    <ui:VisualElement class="detail-split">

                        <!-- LEFT SIDE -->
                        <ui:VisualElement class="detail-left">
                            <ui:VisualElement class="unit-title-row">
                                <ui:Label name="Lbl-UnitName" class="unit-name-large" />
                                <ui:Label name="Lbl-OwnedCount" class="unit-owned-badge" />
                            </ui:VisualElement>

                            <ui:Label name="Lbl-Flavor" class="flavor-text" />
                        </ui:VisualElement>

                        <!-- RIGHT SIDE -->
                        <ui:VisualElement class="detail-right">
                            <ui:VisualElement class="stats-grid">
                                <ui:VisualElement class="stat-column">
                                    <ui:VisualElement class="stat-row"><ui:Label text="POWER" class="stat-label"/><ui:Label name="Stat-Power" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="ARMOR" class="stat-label"/><ui:Label name="Stat-Armor" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="REACH" class="stat-label"/><ui:Label name="Stat-Reach" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="POP" class="stat-label"/><ui:Label name="Stat-Pop" class="stat-value"/></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-column">
                                    <ui:VisualElement class="stat-row"><ui:Label text="DISCIPLINE" class="stat-label"/><ui:Label name="Stat-Discipline" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="MOBILITY" class="stat-label"/><ui:Label name="Stat-Mobility" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="LOOT" class="stat-label"/><ui:Label name="Stat-Loot" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="TIME" class="stat-label"/><ui:Label name="Stat-Time" class="stat-value"/></ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- ACTION BOX -->
                    <ui:VisualElement class="action-box">
                        <ui:VisualElement class="cost-info">
                            <ui:Label text="RECRUITMENT COST" class="section-label-small" />
                            <ui:Label name="Lbl-CostString" class="cost-text" />
                        </ui:VisualElement>

                        <ui:VisualElement class="recruitment-controls">
                            <ui:VisualElement class="slider-container">
                                <ui:SliderInt name="Slider-Quantity" low-value="1" high-value="100" class="game-slider" />
                                <ui:IntegerField name="Input-Quantity" class="game-input-number" />
                            </ui:VisualElement>

                            <ui:Button name="Btn-Recruit"
                                       class="btn-global-base btn-imperial-success recruit-execute-btn"
                                       text="RECRUIT UNITS" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- QUEUE (JA, DEN ER HER NU) -->
                <ui:VisualElement name="Queue-Section" class="queue-section">
                    <ui:Label name="Queue-Header-Label" text="RECRUITMENT QUEUE (0/5)" class="section-label" />
                    <ui:ScrollView
                        name="Recruitment-Queue-List"
                        class="queue-scroll-view"
                        mode="Horizontal"
                        horizontal-scroller-visibility="Auto"
                        vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>