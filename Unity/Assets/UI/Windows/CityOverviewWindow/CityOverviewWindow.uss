/* CityOverviewWindow.uss */

.screen-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.overview-main-container {
    width: 90%;
    max-width: 1000px;
    height: 90%;
    max-height: 750px;
    overflow: hidden;
}

.overview-content-body {
    flex-grow: 1;
    padding: 20px;
    flex-direction: column;
    justify-content: space-between;
}

/* Økonomi Grid */
.economy-grid-container {
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    margin-bottom: 24px;
}

.economy-card-row {
    width: 100%;
    height: 47%;
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;
}

.economy-card-row--four .economy-card {
    width: 23%;
}

.economy-card-row--three .economy-card {
    width: 31%;
}

.economy-card {
    width: 31%;
    height: 100%;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0.08);
    border-width: 1px;
    border-color: var(--c-border);
    border-radius: 6px;
    padding: 10px;
}

.economy-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 5px;
}

.economy-card-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.economy-card-title {
    margin-left: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.breakdown-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.breakdown-label { color: #443322; font-size: 13px; -unity-font-style: bold; }
.breakdown-value { color: #111111; font-size: 13px; -unity-font-style: bold; }

.breakdown-total { 
    color: #004400; 
    font-size: 15px; 
    -unity-font-style: bold; 
    margin-top: 5px; 
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: rgba(0,0,0,0.2);
    -unity-text-align: middle-center;
    width: 100%;
}

/* Bund paneler - Hævet højde for at undgå clipping (Punkt 2 fix) */
.bottom-panels-container {
    flex-direction: row;
    height: 140px; 
    flex-shrink: 0;
}

.overview-panel {
    background-color: rgba(0,0,0,0.05);
    padding: 15px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-border);
}

.population-panel { flex-grow: 1; margin-right: 10px; }
.activity-panel { flex-grow: 1; }
.pop-sub-label { margin-bottom: 4px; }

.status-row { 
    flex-direction: row; 
    justify-content: space-between; 
    align-items: center; /* Holder tekst på linje */
    margin-bottom: 10px; /* Mere luft mellem rækkerne */
}

.pop-bar-bg { 
    display: none;
    height: 0;
    margin: 0;
}

.pop-bar-fill { 
    height: 100%; 
    background-color: #2e7d32; 
}

.panel-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: var(--c-text-header);
    margin-bottom: 8px;
}

.status-label { color: #2B1B10; font-size: 14px; -unity-font-style: bold; }
.status-value { color: var(--c-btn-chill-bg); font-size: 14px; -unity-font-style: bold; }

.icon-wood { background-image: url('project://database/Assets/UI/Icons/Wood.png'); }
.icon-stone { background-image: url('project://database/Assets/UI/Icons/Stone.png'); }
.icon-metal { background-image: url('project://database/Assets/UI/Icons/Metal.png'); }
.icon-coins { background-image: url('project://database/Assets/UI/Icons/coins.png'); }
.icon-cloth { background-image: url('project://database/Assets/UI/Icons/cloth.png'); }
.icon-coal { background-image: url('project://database/Assets/UI/Icons/coal.png'); }
.icon-copper { background-image: url('project://database/Assets/UI/Icons/copper.png'); }
.icon-cotton { background-image: url('project://database/Assets/UI/Icons/cotton.png'); }
.icon-diamond { background-image: url('project://database/Assets/UI/Icons/diamond.png'); }
.icon-gold { background-image: url('project://database/Assets/UI/Icons/gold.png'); }
.icon-ivory { background-image: url('project://database/Assets/UI/Icons/ivory.png'); }
