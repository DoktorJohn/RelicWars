<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="WorldSelectionWindow.uss" />

    <ui:VisualElement name="World-Overlay" class="world-selection-overlay">
        <ui:VisualElement name="World-Vignette" class="world-selection-vignette" />
        <ui:VisualElement class="world-selection-safe-area">
            <ui:VisualElement name="World-Window-MainContainer" class="window-frame world-main-container">
                <ui:VisualElement class="window-header world-scene-header">
                    <ui:Label text="WORLD SELECT" class="window-header-label" />
                </ui:VisualElement>
                <ui:VisualElement class="window-content-container world-content-body">
                    <ui:VisualElement class="world-top-controls">
                        <ui:Button name="Button-Back-To-Login" text="BACK" class="btn-global-base btn-imperial-primary world-back-button" />
                    </ui:VisualElement>

                    <ui:VisualElement class="player-welcome-block">
                        <ui:Label text="WELCOME BACK" class="welcome-text-regular" />
                        <ui:Label name="Label-Player-Name" text="" class="player-name-highlight" />
                    </ui:VisualElement>

                    <ui:ScrollView name="Scroll-World-List" class="world-list-scrollview" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
