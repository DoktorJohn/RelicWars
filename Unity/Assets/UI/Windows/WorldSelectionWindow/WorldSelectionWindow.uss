.world-selection-overlay {
    position: relative;
    flex-grow: 1;
    background-color: rgb(20, 14, 11);
    background-image: url("project://database/Assets/Login_background_image.jpg");
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.world-selection-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 8, 6, 0.66);
}

.world-selection-safe-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 24px;
    justify-content: center;
    align-items: center;
}

.world-main-container {
    position: relative;
    width: 720px;
    max-width: 92%;
    height: 620px;
    max-height: 94%;
}

.world-scene-header {
    flex-shrink: 0;
    justify-content: center;
    cursor: default;
}

.world-content-body {
    padding: 26px 38px 36px 38px;
    flex-grow: 1;
    min-height: 0;
}

.world-top-controls {
    flex-direction: row;
    justify-content: flex-start;
}

.world-back-button {
    width: 90px;
    min-width: 90px;
    height: 34px;
    min-height: 34px;
    margin: 0;
    padding: 0 10px;
    font-size: 10px;
}

.player-welcome-block {
    margin: 34px 2px 30px 2px;
}

.welcome-text-regular {
    color: var(--c-text-body);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 30px;
    letter-spacing: 1.2px;
}

.player-name-highlight {
    margin-top: 4px;
    color: var(--c-text-header);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 36px;
    letter-spacing: 1px;
    white-space: normal;
}

.world-list-scrollview {
    flex-grow: 1;
    min-height: 0;
}

.world-list-scrollview #unity-content-container {
    padding-right: 4px;
}

.world-entry-row {
    min-height: 104px;
    margin-bottom: 12px;
    padding: 16px 18px 16px 0;
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.18);
    border-width: 1px;
    border-color: rgba(112, 82, 42, 0.58);
    border-radius: 6px;
    overflow: hidden;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.world-entry-row:hover {
    background-color: rgba(255, 248, 232, 0.36);
    border-color: var(--c-text-highlight);
}

.world-entry-accent {
    width: 5px;
    height: 100%;
    min-width: 5px;
    margin-right: 18px;
    background-color: var(--c-text-highlight);
}

.world-info-group {
    min-width: 0;
    flex-grow: 1;
    justify-content: center;
}

.world-name-label {
    margin-bottom: 5px;
    color: var(--c-text-header);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 22px;
    white-space: normal;
}

.world-stats-label {
    color: var(--c-text-muted);
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    font-size: 14px;
}

.world-enter-button {
    width: 132px;
    min-width: 132px;
    margin: 0 0 0 18px;
}

.layout-tablet .world-selection-safe-area {
    padding: 20px;
}

.layout-tablet .world-main-container {
    width: 620px;
    height: 580px;
}

.layout-phone .world-selection-safe-area {
    padding: 0;
    justify-content: flex-start;
    align-items: stretch;
}

.layout-phone .world-main-container {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
}

.layout-phone .world-back-button {
    width: 72px;
    min-width: 72px;
}

.layout-phone .world-back-button {
    height: 44px;
    min-height: 44px;
}

.layout-phone .world-content-body {
    padding: 20px 18px 22px 18px;
}

.layout-phone .player-welcome-block {
    margin-top: 26px;
    margin-bottom: 24px;
}

.layout-phone .welcome-text-regular {
    font-size: 24px;
}

.layout-phone .player-name-highlight {
    font-size: 29px;
}

.layout-phone .world-entry-row {
    min-height: 122px;
    padding-right: 12px;
    flex-wrap: wrap;
}

.layout-phone .world-info-group {
    min-width: 190px;
}

.layout-phone .world-name-label {
    font-size: 19px;
}

.layout-phone .world-enter-button {
    width: 118px;
    min-width: 118px;
    min-height: 44px;
    margin-left: 10px;
}
