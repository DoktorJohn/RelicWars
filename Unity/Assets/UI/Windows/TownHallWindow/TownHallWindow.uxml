<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="TownHallWindow.uss" />
    <ui:VisualElement name="TownHall-Window-Overlay" picking-mode="Ignore" class="screen-overlay">
        
            <ui:VisualElement name="TownHall-Window-MainContainer" class="window-frame townhall-window-size">
            
            <ui:VisualElement name="TownHall-Window-Header" class="window-header">
                <ui:Label name="TownHall-Label-Title" class="window-header-label" text="THE TOWNHALL" />
                <ui:Button name="Header-Close-Button" class="window-close-btn" text="x" />
            </ui:VisualElement>
            
            <ui:VisualElement class="townhall-content">
                <ui:VisualElement class="window-tabs townhall-tabs">
                    <ui:Button name="TownHall-Buildings-Tab" text="BUILDINGS" class="window-tab window-tab-active" />
                    <ui:Button name="TownHall-Edicts-Tab" text="EDICTS" class="window-tab" />
                </ui:VisualElement>
                <ui:VisualElement class="divider townhall-divider" />
                
                <ui:VisualElement name="TownHall-Buildings-Panel" class="townhall-buildings-panel"><ui:ScrollView name="TownHall-Building-List" class="building-grid-view" />
                
                <ui:VisualElement name="Queue-Section" class="queue-section">
                    <ui:Label name="Queue-Header-Label" text="CONSTRUCTION QUEUE" class="queue-header-label" />
                    <ui:ScrollView name="Building-Queue-List" class="queue-scroll-view" mode="Horizontal" />
                </ui:VisualElement></ui:VisualElement>
                <ui:VisualElement name="TownHall-Edicts-Panel" class="edicts-panel"><ui:Label name="TownHall-Edict-Status" class="edict-status" /><ui:ScrollView name="TownHall-Edict-List" class="edicts-list" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Resource-Tooltip" class="window-frame floating-window-frame resource-tooltip" picking-mode="Ignore">
            <ui:Label text="CONSTRUCTION COST" class="tooltip-title" />
            <ui:VisualElement class="tooltip-row">
                <ui:Label text="Wood:" class="tooltip-label" style="color:#C89664;" />
                <ui:Label name="Tip-Wood" text="" class="tooltip-label" />
            </ui:VisualElement>
            <ui:VisualElement class="tooltip-row">
                <ui:Label text="Stone:" class="tooltip-label" style="color:#969696;" />
                <ui:Label name="Tip-Stone" text="" class="tooltip-label" />
            </ui:VisualElement>
            <ui:VisualElement class="tooltip-row">
                <ui:Label text="Metal:" class="tooltip-label" style="color:#B4C8DC;" />
                <ui:Label name="Tip-Metal" text="" class="tooltip-label" />
            </ui:VisualElement>
            <ui:VisualElement class="tooltip-row" style="margin-top: 5px;">
                <ui:Label text="Time:" class="tooltip-label" style="color:#64C864;" />
                <ui:Label name="Tip-Time" text="" class="tooltip-label" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
