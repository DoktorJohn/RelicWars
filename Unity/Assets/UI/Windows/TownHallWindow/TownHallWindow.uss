/* --- BUILDING GRID SECTION --- */
.building-grid-view {
    flex-grow: 1;
    flex-basis: 0; 
    margin-bottom: 5px;
    overflow: hidden;
}

.building-grid-view .unity-scroll-view__content-container {
    flex-direction: row; 
    flex-wrap: wrap;     
    justify-content: center;
    align-items: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 25px; 
    min-width: 100%;
}

/* HIDE SCROLLBARS */
.unity-scroller { display: none; opacity: 0; }
.unity-scroller--vertical { width: 0; }
.unity-scroller--horizontal { height: 0; }

/* --- BUILDING CARD --- */
.building-card {
    width: 290px;
    height: 90px;
    margin: 8px; 
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.3);
    border-radius: 6px;
    padding: 10px;
    justify-content: space-between; 
    transition-duration: 0.1s;
}

.building-card:hover {
    border-color: rgba(181, 145, 70, 0.55);
    background-color: rgba(165, 125, 50, 0.16);
    scale: 1.02;
}

/* FIX: Fjernet border-bottom-width som skabte "ghost line" buggen */
.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 5px;
    margin-bottom: 5px;
    /* Vi fjerner den hvide 1px border her, da den ofte "bløder" igennem layoutet */
    border-bottom-width: 0;
}

.card-name {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 16px; 
    -unity-font-style: bold;
}

.card-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 14px;
    -unity-font-style: bold;
}

.card-upgrade-button {
    width: 100%;
    height: 32px;
}

.card-upgrade-button.btn-imperial-success:hover {
    background-color: rgba(165, 125, 50, 0.18);
    border-color: rgba(181, 145, 70, 0.55);
}

.card-upgrade-button.btn-imperial-success:active {
    background-color: rgba(165, 125, 50, 0.24);
}

/* --- QUEUE SECTION --- */
.queue-section {
    margin-top: 0;
    min-height: 135px; 
    width: 100%;
    flex-shrink: 0; 
    border-top-width: 1px;
    border-top-color: rgba(165, 125, 50, 0.3);
    padding-top: 8px;
}

.queue-header-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 20px; 
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: var(--c-text-header);
}

.queue-scroll-view {
    flex-grow: 1;
    height: 100px;
}

/* --- QUEUE ITEM CARD --- */
.queue-item-card {
    width: 182px; 
    height: 95px; 
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 6px;
    padding: 8px;
    justify-content: space-between;
}

.queue-item-card:last-child {
    margin-right: 0;
}

.queue-item-info-container {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
}

.queue-item-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 13px;
    -unity-font-style: bold;
    height: 18px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.queue-item-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 11px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    height: 16px;
}

.queue-level-arrow {
    color: #90D890;
    font-size: 11px;
    margin-left: 3px;
    margin-right: 3px;
}

.queue-item-time {
    -unity-font-definition: var(--font-body);
    color: #90D890;
    font-size: 15px;
    -unity-font-style: bold;
}

/* --- TOOLTIP (Forbedret Layout & Synlighed) --- */
.resource-tooltip {
    position: absolute;
    width: 260px;
    background-color: rgba(10, 10, 10, 0.99); 
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 8px;
    padding: 15px;
    display: none; 
    z-index: 999;
    picking-mode: ignore; 
}

.tooltip-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-highlight);
    font-size: 14px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.5);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tooltip-row {
    flex-direction: row;
    justify-content: space-between; 
    align-items: center;
    margin-bottom: 6px;
    width: 100%;
}

.tooltip-label {
    -unity-font-definition: var(--font-body);
    font-size: 13px;
    -unity-font-style: bold;
    /* Farven herover bliver overskrevet af UXML inline styles ( Wood/Stone/Metal ) */
}

/* High-contrast tekst til tallene for optimal læsbarhed */
#Tip-Wood, #Tip-Stone, #Tip-Metal, #Tip-Time {
    color: #FFFFFF; 
    -unity-font-definition: var(--font-body);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
}

#Tip-Time {
    color: #90D890; /* Lys grøn for tid */
}

/* --- TEXTS --- */
.text-flavor {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 16px; 
    -unity-font-style: italic; 
    margin-bottom: 8px;
}

.queue-empty-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 18px; 
    -unity-font-style: bold; 
    margin-top: 5px;
}

.divider {
    height: 1px;
    background-color: var(--c-border);
    opacity: 0.4;
}
