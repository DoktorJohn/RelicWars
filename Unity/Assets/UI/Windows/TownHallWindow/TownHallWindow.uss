/* --- BUILDING GRID SECTION --- */
.building-grid-view {
    flex-grow: 1;
    flex-basis: 0; 
    margin-bottom: 5px;
    overflow: hidden;
}

.building-grid-view .unity-scroll-view__content-container {
    flex-direction: row; 
    flex-wrap: wrap;     
    /* FIX: Centrerer kortene så afstanden til venstre og højre er ens */
    justify-content: center;
    align-items: flex-start;
    padding-left: 0;
    padding-right: 0;
    /* FIX: Mindre padding-bottom er nu nok, da layoutet er mere stabilt */
    padding-bottom: 25px; 
    min-width: 100%;
}

/* HIDE SCROLLBARS */
.unity-scroller { display: none; opacity: 0; }
.unity-scroller--vertical { width: 0; }
.unity-scroller--horizontal { height: 0; }

/* --- BUILDING CARD --- */
.building-card {
    /* 3 kort á 290px + margin (16px hver) = 918px. 
       I et 1000px vindue (960px efter padding) giver det 21px luft i hver side vha. justify-content: center */
    width: 290px;
    height: 90px;
    margin: 8px; 
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.3);
    border-radius: 6px;
    padding: 10px;
    justify-content: space-between; 
    transition-duration: 0.1s;
}

.building-card:hover {
    border-color: var(--c-border); 
    background-color: rgba(0, 0, 0, 0.3);
    scale: 1.02;
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    padding-bottom: 5px;
    margin-bottom: 5px;
}

.card-name {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 16px; 
    -unity-font-style: bold;
}

.card-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 14px;
    -unity-font-style: bold;
}

.card-upgrade-button {
    width: 100%;
    height: 32px;
}

/* --- QUEUE SECTION (Kompakteret for at give plads til griddet) --- */
.queue-section {
    margin-top: 0;
    /* FIX: Reduceret min-height for at give mere plads til bygnings-grid */
    min-height: 135px; 
    width: 100%;
    flex-shrink: 0; 
    border-top-width: 1px;
    border-top-color: rgba(165, 125, 50, 0.3);
    padding-top: 8px;
}

.queue-header-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 20px; /* Reduceret fra 22px */
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: var(--c-text-header);
}

.queue-scroll-view {
    flex-grow: 1;
    height: 100px; /* Reduceret fra 120px */
}

/* --- QUEUE ITEM CARD (Kompakteret vertikalt) --- */
.queue-item-card {
    width: 182px; 
    height: 95px; /* Reduceret fra 115px for at redde griddet ovenover */
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 6px;
    padding: 8px;
    justify-content: space-between;
}

.queue-item-card:last-child {
    margin-right: 0;
}

.queue-item-info-container {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
}

.queue-item-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 13px;
    -unity-font-style: bold;
    height: 18px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.queue-item-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 11px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    height: 16px;
}

.queue-level-arrow {
    color: #90D890;
    font-size: 11px;
    margin-left: 3px;
    margin-right: 3px;
}

.queue-item-time {
    -unity-font-definition: var(--font-body);
    color: #90D890;
    font-size: 15px;
    -unity-font-style: bold;
}

/* --- TOOLTIP --- */
.resource-tooltip {
    position: absolute;
    width: 240px;
    background-color: rgba(25, 22, 20, 0.98); 
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 8px;
    padding: 12px;
    display: none; 
    z-index: 999;
}

.tooltip-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-highlight);
    font-size: 13px;
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* --- TEXTS --- */
.text-flavor {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 16px; 
    -unity-font-style: italic; 
    margin-bottom: 8px;
}

.queue-empty-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 18px; 
    -unity-font-style: bold; 
    margin-top: 5px;
}

.divider {
    height: 1px;
    background-color: var(--c-border);
    opacity: 0.4;
}