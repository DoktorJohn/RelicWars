/* --- BUILDING GRID SECTION --- */
.townhall-window-size { width: 1000px; height: 750px; }
.townhall-content { padding: 8px 20px 14px 20px; flex-grow: 1; min-height: 0; }
.townhall-tabs { flex-shrink: 0; margin-bottom: 3px; }
.townhall-divider { margin-bottom: 5px; }
.townhall-buildings-panel { flex-grow: 1; min-height: 0; }
.edicts-panel { display: none; flex-grow: 1; }
.edicts-list { flex-grow: 1; min-height: 0; }
.edict-status { color: var(--c-text-highlight); margin-bottom: 6px; -unity-font-definition: var(--font-body); -unity-font-style: bold; font-size: 12px; }
.edict-card { min-height: 76px; margin: 2px; padding: 7px 9px; background-color: rgba(255,255,255,.14); border-width: 1px; border-color: rgba(165,125,50,.28); border-radius: 5px; }
.edict-card-active { background-color: rgba(165,125,50,.20); border-color: rgba(165,125,50,.78); }
.edict-card-header { height: 28px; flex-direction: row; align-items: center; }
.edict-name { flex-grow: 1; min-width: 0; color: var(--c-text-header); -unity-font-definition: var(--font-header); font-size: 13px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.edict-active { color: var(--c-value-positive); margin-left: 8px; -unity-font-style: bold; font-size: 10px; }
.edict-meta { color: var(--c-text-muted); margin-left: 10px; font-size: 10px; white-space: nowrap; }
.edict-effects { flex-direction: row; min-height: 30px; }
.edict-benefit, .edict-downside { width: 50%; white-space: normal; -unity-font-definition: var(--font-body); font-size: 11px; }
.edict-benefit { color: var(--c-value-positive); padding-right: 8px; }
.edict-downside { color: var(--c-value-negative); padding-left: 8px; }
.edict-action { width: 112px; min-width: 112px; height: 28px; min-height: 28px; margin: 0 0 0 10px; padding: 2px 8px; font-size: 10px; }

.building-grid-view {
    flex-grow: 1;
    flex-basis: 0; 
    margin-bottom: 5px;
    overflow: hidden;
}

.building-grid-view .unity-scroll-view__content-container {
    flex-direction: column;
    align-items: center;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 5px;
    min-width: 100%;
}

.building-secondary-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

/* HIDE SCROLLBARS */
.unity-scroller { display: none; opacity: 0; }
.unity-scroller--vertical { width: 0; }
.unity-scroller--horizontal { height: 0; }

/* --- BUILDING CARD --- */
.building-card {
    width: 290px;
    height: 90px;
    margin: 8px; 
    background-color: rgba(0, 0, 0, 0.2);
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.3);
    border-radius: 6px;
    padding: 10px;
    justify-content: space-between; 
    transition-duration: 0.1s;
}

.building-card:hover {
    border-color: rgba(181, 145, 70, 0.55);
    background-color: rgba(165, 125, 50, 0.16);
    scale: 1.02;
}

.building-card-townhall {
    width: 290px;
    flex-shrink: 0;
}

.building-secondary-grid .building-card {
    width: 215px;
}

/* FIX: Fjernet border-bottom-width som skabte "ghost line" buggen */
.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 5px;
    margin-bottom: 5px;
    /* Vi fjerner den hvide 1px border her, da den ofte "bløder" igennem layoutet */
    border-bottom-width: 0;
}

.card-name {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 16px; 
    -unity-font-style: bold;
}

.card-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 14px;
    -unity-font-style: bold;
}

.card-upgrade-button {
    width: 100%;
    height: 32px;
}

.card-upgrade-button.btn-imperial-success:hover {
    background-color: rgba(165, 125, 50, 0.18);
    border-color: rgba(181, 145, 70, 0.55);
}

.card-upgrade-button.btn-imperial-success:active {
    background-color: rgba(165, 125, 50, 0.24);
}

/* --- QUEUE SECTION --- */
.queue-section {
    margin-top: 0;
    height: 100px;
    min-height: 100px;
    width: 100%;
    flex-shrink: 0; 
    border-top-width: 1px;
    border-top-color: rgba(165, 125, 50, 0.3);
    padding-top: 5px;
}

.queue-header-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: var(--c-text-header);
}

.queue-scroll-view {
    flex-grow: 1;
    height: 68px;
}

/* --- QUEUE ITEM CARD --- */
.queue-item-card {
    width: 182px; 
    height: 64px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 6px;
    padding: 5px 8px;
    justify-content: space-between;
}

.queue-item-card:last-child {
    margin-right: 0;
}

.queue-item-info-container {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
}

.queue-item-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 13px;
    -unity-font-style: bold;
    height: 18px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.queue-item-level {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 11px;
    -unity-font-style: bold;
    flex-direction: row;
    align-items: center;
    height: 16px;
}

.queue-level-arrow {
    color: #90D890;
    font-size: 11px;
    margin-left: 3px;
    margin-right: 3px;
}

.queue-item-time {
    -unity-font-definition: var(--font-body);
    color: #90D890;
    font-size: 15px;
    -unity-font-style: bold;
}

/* --- TOOLTIP (Forbedret Layout & Synlighed) --- */
.resource-tooltip {
    position: absolute;
    width: 260px;
    background-color: rgba(10, 10, 10, 0.99); 
    padding: 15px;
    display: none; 
    z-index: 999;
    picking-mode: ignore; 
}

.tooltip-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-highlight);
    font-size: 14px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.5);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tooltip-row {
    flex-direction: row;
    justify-content: space-between; 
    align-items: center;
    margin-bottom: 6px;
    width: 100%;
}

.tooltip-label {
    -unity-font-definition: var(--font-body);
    font-size: 13px;
    -unity-font-style: bold;
    /* Farven herover bliver overskrevet af UXML inline styles ( Wood/Stone/Metal ) */
}

/* High-contrast tekst til tallene for optimal læsbarhed */
#Tip-Wood, #Tip-Stone, #Tip-Metal, #Tip-Time {
    color: #FFFFFF; 
    -unity-font-definition: var(--font-body);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
}

#Tip-Time {
    color: #90D890; /* Lys grøn for tid */
}

/* --- TEXTS --- */
.text-flavor {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 16px; 
    -unity-font-style: italic; 
    margin-bottom: 8px;
}

.queue-empty-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 18px; 
    -unity-font-style: bold; 
    margin-top: 5px;
}

.divider {
    height: 1px;
    background-color: var(--c-border);
    opacity: 0.4;
}
