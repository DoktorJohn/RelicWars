/* =========================================================
   TABLE SYSTEM (THE FLUSH FIX)
   ========================================================= */
.table-main-area {
    width: 100%;
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: rgba(0, 0, 0, 0.05);
}

.table-header-row {
    width: 100%;
    height: 45px;
    flex-direction: row;
    background-color: var(--c-btn-chill-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-border);
    /* Matcher præcis ScrollViewets indhold når vertical scroll er Always */
    padding-right: 18px; 
}

.ranking-scrollview {
    flex-grow: 1;
    /* Hard-lock: Ingen horisontal scroll overhovedet */
}

/* TVING INTERN CONTAINER TIL AT MATCHE BREDDEN */
.ranking-scrollview #unity-content-container {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden; /* Fjerner horisontal blødning */
}

/* SKJUL DEN HORISONTALE SCROLLER HELT VIA CSS */
.ranking-scrollview .unity-scroll-view__horizontal-scroller {
    display: none;
    opacity: 0;
    height: 0;
    width: 0;
}

.table-row {
    width: 100%;
    height: 40px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.2);
}

/* =========================================================
   COLUMN SYSTEM (Mathematical Alignment)
   ========================================================= */
.col-rank     { width: 10%; flex-shrink: 0; -unity-text-align: middle-center; }
.col-name     { width: 35%; flex-shrink: 0; -unity-text-align: middle-center; }
.col-ideology { width: 15%; flex-shrink: 0; -unity-text-align: middle-center; }
.col-alliance { width: 25%; flex-shrink: 0; -unity-text-align: middle-center; }
.col-score    { width: 15%; flex-shrink: 0; -unity-text-align: middle-center; }

.table-header-label {
    -unity-font-definition: var(--font-header);
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
}

.row-label {
    -unity-font-definition: var(--font-body);
    font-size: 14px;
    color: var(--c-text-body);
}

.ranking-window-size {
    width: 1100px;
    height: 750px;
    background-color: var(--c-window-bg);
}

.ranking-content-container {
    padding: 25px;
    flex-grow: 1;
}

.ranking-close-pos {
    position: absolute;
    top: 15px;
    right: 15px;
}