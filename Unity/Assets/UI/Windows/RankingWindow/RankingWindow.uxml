<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="RankingWindow.uss" />

    <ui:VisualElement class="screen-overlay" picking-mode="Ignore">
        <ui:VisualElement name="Ranking-Window-MainContainer" class="window-frame ranking-window-size">
            
            <ui:VisualElement name="Ranking-Window-Header" class="window-header">
                <ui:Label class="window-header-label" text="RANKINGS" />
                <ui:Button name="RankingWindow-Close-Button" class="window-close-btn" text="×" />
            </ui:VisualElement>

            <ui:VisualElement class="ranking-content-container">
                
                <ui:VisualElement class="table-main-area">
                    <ui:VisualElement class="table-header-row">
                        <ui:Label text="#" class="table-header-label col-rank" />
                        <ui:Label text="PLAYER" class="table-header-label col-name" />
                        <ui:Label text="IDEOLOGY" class="table-header-label col-ideology" />
                        <ui:Label text="ALLIANCE" class="table-header-label col-alliance" />
                        <ui:Label text="POINTS" class="table-header-label col-score" />
                    </ui:VisualElement>

                    <ui:ScrollView name="Ranking-List-Container" 
                                   class="ranking-scrollview" 
                                   vertical-scroller-visibility="Always" 
                                   horizontal-scroller-visibility="Hidden" 
                                   mode="Vertical" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>