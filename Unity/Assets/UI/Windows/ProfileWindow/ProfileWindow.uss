/* Assets/UI/Windows/ProfileWindow/ProfileWindow.uss */

.profile-window-size {
    width: 840px;
    height: 760px;
}

/* --- LAYOUT --- */
.profile-content-container {
    flex-grow: 1;
    padding: 18px 20px 20px 20px;
    overflow: hidden;
}

.profile-columns {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
}

.profile-column {
    flex-direction: column;
    min-width: 0;
    align-items: stretch;
    flex-basis: 0;
}

.profile-column-left {
    flex-grow: 1;
    margin-right: 18px;
}

.profile-column-right {
    flex-grow: 1;
}

.profile-divider {
    width: 100%;
    margin-bottom: 14px;
}

.profile-section {
    width: 100%;
    margin-bottom: 14px;
}

.profile-section-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.profile-description-header {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

/* --- AVATAR --- */
.profile-avatar {
    width: 132px;
    height: 132px;
    margin-top: 4px;
    margin-bottom: 8px;
    align-self: center;
    background-color: rgba(0,0,0,0.3);
    -unity-background-scale-mode: scale-to-fit;
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 50%;
}

/* --- TEXT ELEMENTS --- */
.profile-name {
    -unity-font-definition: var(--font-header);
    width: 100%;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    margin-bottom: 2px;
}

.profile-alliance {
    -unity-font-definition: var(--font-body);
    width: 100%;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    align-self: center;
    margin-bottom: 12px;
    letter-spacing: 0.6px;
}

.profile-action-row {
    width: 100%;
    justify-content: flex-start;
    margin-bottom: 10px;
}

.profile-action-button {
    min-width: 180px;
}

.profile-invite-button {
    margin-left: 8px;
}

.profile-action-status {
    width: 100%;
    margin-top: -4px;
    margin-bottom: 10px;
    color: var(--c-text-muted);
    -unity-font-definition: var(--font-body);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
}

/* --- STATS GRID --- */
.profile-stats-grid {
    flex-direction: row;
    width: 100%;
    min-height: 84px;
    background-color: rgba(0, 0, 0, 0.07);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.18);
    align-items: center;
    justify-content: space-between;
    margin-top: 34px;
    margin-bottom: 14px;
    padding: 4px 2px;
}

.stat-box {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    padding: 6px 0;
}

.stat-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.1px;
    margin-bottom: 4px;
}

.stat-value {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-highlight);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* --- DESCRIPTION --- */
.profile-description {
    width: 100%;
    -unity-font-definition: var(--font-body);
    color: var(--c-text-body);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: upper-left;
    -unity-font-style: italic;
    padding-left: 4px;
    padding-right: 4px;
}

.profile-description-edit-btn {
    width: 30px;
    height: 30px;
    margin-top: 0;
    padding: 0;
    border-radius: 15px;
    font-size: 18px;
    -unity-text-align: middle-center;
    background-color: var(--c-btn-chill-bg);
    border-width: 1px;
    border-color: var(--c-btn-chill-border);
    color: white;
}

.profile-description-editor {
    width: 100%;
    min-width: 0;
    flex-direction: column;
}

.profile-description-section {
    flex-grow: 1;
    margin-top: 4px;
}

.profile-description-input {
    width: 100%;
    flex-grow: 1;
    min-width: 0;
    min-height: 96px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.08);
    border-width: 1px;
    border-color: var(--c-border);
    border-radius: 6px;
    color: var(--c-text-body);
    -unity-font-definition: var(--font-body);
    -unity-font-style: normal;
    font-size: 14px;
    white-space: normal;
}

.profile-description-input > .unity-base-text-field__input {
    width: 100%;
    min-width: 0;
}

.profile-description-actions {
    width: 100%;
    flex-direction: row;
    justify-content: flex-end;
}

.profile-save-description-btn {
    width: 180px;
    min-width: 180px;
    margin-top: 0;
}

.profile-cancel-description-btn {
    width: 110px;
    min-width: 110px;
    margin-top: 0;
    margin-left: 8px;
}

/* --- CITY LIST --- */
.profile-cities-section {
    flex-grow: 1;
}

.profile-cities-list {
    flex-grow: 1;
    width: 100%;
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.35);
    background-color: rgba(0, 0, 0, 0.06);
    overflow: hidden;
}

.profile-city-heading {
    width: 100%;
    height: 34px;
    padding-right: 14px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--c-header-bg);
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: var(--c-border);
}

.profile-city-heading-name,
.profile-city-heading-coordinates,
.profile-city-heading-points {
    color: var(--c-text-header);
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    font-size: 10px;
    letter-spacing: 0.6px;
    -unity-text-align: middle-center;
}

.profile-city-heading-name,
.profile-city-name { width: 50%; }

.profile-city-heading-coordinates,
.profile-city-coordinates { width: 28%; }

.profile-city-heading-points,
.profile-city-points { width: 22%; }

.profile-cities-list #unity-content-container {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    overflow: hidden;
}

.profile-cities-list .unity-scroll-view__horizontal-scroller {
    display: none;
    opacity: 0;
    height: 0;
    width: 0;
}

.profile-city-row {
    width: 100%;
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.15);
    background-color: rgba(255, 255, 255, 0.08);
}

.profile-city-name {
    padding-left: 12px;
    padding-right: 8px;
    -unity-font-definition: var(--font-body);
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.profile-city-coordinates {
    -unity-font-definition: var(--font-body);
    font-size: 12px;
    -unity-text-align: middle-center;
    color: var(--c-text-body);
    white-space: nowrap;
}

.profile-city-points {
    padding-right: 4px;
    -unity-font-definition: var(--font-body);
    font-size: 12px;
    -unity-text-align: middle-center;
    color: var(--c-text-body);
    white-space: nowrap;
}

.profile-column-right .profile-description-header {
    margin-bottom: 10px;
}
