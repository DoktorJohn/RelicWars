<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Windows/WorldUnitDeploymentWindow/WorldUnitDeploymentWindow.uss" />
    
    <ui:VisualElement name="Deployment-Window-MainContainer" class="window-frame deployment-mini-window">
        <ui:VisualElement class="deployment-body">
            <ui:Label text="MARCH ORDERS" class="deployment-title" />
            <ui:Label name="Destination-Label" text="Target: 0, 0" class="deployment-coords" />
            
            <ui:VisualElement class="deployment-row">
                <ui:Button name="Btn-Confirm-Move" text="MOVE" class="btn-global-base btn-imperial-success deployment-btn" />
                <ui:Button name="Btn-Cancel-Command" text="CANCEL" class="btn-global-base btn-imperial-danger deployment-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>