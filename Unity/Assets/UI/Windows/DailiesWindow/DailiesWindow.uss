.dailies-window-size {
    width: 1100px;
    height: 720px;
    background-color: var(--c-window-bg);
}

.dailies-content {
    flex-grow: 1;
    min-height: 0;
    padding: 22px;
}

#Dailies-Data {
    flex-grow: 1;
    min-height: 0;
}

.dailies-reset-panel {
    min-height: 82px;
    margin-bottom: 16px;
    padding: 14px 20px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(31, 34, 37);
    border-left-width: 3px;
    border-left-color: rgb(205, 166, 88);
    border-bottom-width: 1px;
    border-bottom-color: rgb(12, 14, 15);
    border-radius: 3px;
}

.dailies-reset-title {
    color: rgb(205, 166, 88);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 1px;
}

.dailies-reset-subtitle {
    margin-top: 3px;
    color: rgb(159, 155, 145);
    -unity-font-definition: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.6px;
}

.dailies-reset-countdown {
    color: var(--c-value-total-on-dark);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 30px;
    letter-spacing: 1px;
    -unity-text-align: middle-right;
}

.dailies-table-scroll {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: var(--c-border);
    background-color: rgba(0, 0, 0, 0.05);
}

.dailies-table-scroll #unity-content-container {
    min-width: 100%;
    padding: 0;
    margin: 0;
}

.dailies-table {
    width: 100%;
    min-width: 0;
}

.dailies-table-header,
.dailies-table-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
}

.dailies-table-header {
    height: 44px;
    flex-shrink: 0;
    background-color: var(--c-btn-chill-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-border);
}

.dailies-table-row {
    min-height: 42px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.22);
}

.dailies-table-row:hover {
    background-color: rgba(132, 96, 42, 0.08);
}

.dailies-header-label,
.dailies-row-label {
    padding-right: 8px;
    padding-left: 8px;
    min-width: 0;
    -unity-text-align: middle-center;
}

.dailies-header-label {
    color: white;
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 14px;
}

.dailies-row-label {
    color: var(--c-text-body);
    -unity-font-definition: var(--font-body);
    font-size: 13px;
}

.dailies-col-level { width: auto; flex-basis: 0; flex-grow: 8; }
.dailies-col-objective { width: auto; flex-basis: 0; flex-grow: 36; }
.dailies-col-completion { width: auto; flex-basis: 0; flex-grow: 20; }
.dailies-col-reward { width: auto; flex-basis: 0; flex-grow: 22; }
.dailies-col-claim { width: auto; flex-basis: 0; flex-grow: 14; }

.dailies-claim-cell {
    padding-right: 8px;
    padding-left: 8px;
    min-width: 0;
    align-items: center;
    justify-content: center;
}

.dailies-status-label {
    width: 100%;
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--c-value-positive);
}

.dailies-row-coming-soon .dailies-status-label {
    color: var(--c-value-warning);
}
