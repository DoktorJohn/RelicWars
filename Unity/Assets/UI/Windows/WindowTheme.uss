/* Assets/UI/Windows/WindowTheme.uss */
@import url("ResponsiveLayout.uss");

/* ============================================================
   GLOBAL VARIABLES & FONTS (VIBRANT STONE)
   ============================================================ */
:root {
    /* --- ROMAN PALETTE --- */
    --c-window-bg: rgb(211, 199, 181);
    --c-header-bg: rgb(66, 54, 45);
    --c-border: rgb(181, 145, 70);
    --c-window-edge: rgb(55, 43, 31);
    --c-window-title: rgb(239, 220, 174);
    
    /* --- TEXT COLORS --- */
    --c-text-header: rgb(110, 20, 20); 
    --c-text-body: rgb(15, 15, 15);
    --c-text-muted: rgb(90, 80, 70);
    --c-text-highlight: rgb(165, 125, 50);
    --c-entity-link: rgb(145, 45, 45);
    --c-entity-link-hover: rgb(100, 180, 255);

    /* --- SEMANTIC VALUES (light surfaces / dark HUD) --- */
    --c-value-positive: rgb(28, 103, 52);
    --c-value-total: rgb(122, 71, 8);
    --c-value-warning: rgb(148, 78, 0);
    --c-value-negative: rgb(150, 34, 34);
    --c-value-positive-on-dark: rgb(119, 207, 126);
    --c-value-total-on-dark: rgb(238, 194, 103);
    --c-value-warning-on-dark: rgb(241, 163, 73);
    --c-value-negative-on-dark: rgb(235, 104, 94);

    /* --- IMPERIAL BUTTONS --- */
    /* Chill / Primary (Red) */
    --c-btn-chill-bg: rgb(155, 45, 35);
    --c-btn-chill-border: rgb(120, 30, 20);
    
    /* Warn / Danger (Dark Red) */
    --c-btn-warn-bg: rgb(90, 40, 30);
    --c-btn-warn-border: rgb(70, 25, 15);

    /* Action / Success (Green/Gold - NY TILFØJET GLOBAL) */
    --c-btn-action-bg: rgb(60, 110, 60);
    --c-btn-action-border: rgb(40, 80, 40);

    /* --- FONTS --- */
    --font-header: url("project://database/Assets/TextMesh Pro/Fonts/Cinzel.asset");
    --font-body: url("project://database/Assets/TextMesh Pro/Fonts/Roboto.asset");

    /* --- ASSETS --- */
    --img-window-background: url("project://database/Assets/UI/BackgroundUI.png");
}


/* ============================================================
   GLOBAL BUTTON SYSTEM (NYT)
   ============================================================ */

/* Base styling for ALLE knapper */
.btn-global-base {
    height: 42px;
    border-radius: 4px;
    border-width: 1px;
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 14px;
    color: white;
    margin-top: 10px;
    padding: 5px 15px;
    transition-duration: 0.1s;
    justify-content: center;
    align-items: center;
}

.btn-global-base:hover {
    scale: 1.02;
}

.btn-global-base:active {
    scale: 0.98;
}

/* Variant: Success (Create Alliance etc.) */
.btn-imperial-success {
    background-color: var(--c-btn-action-bg);
    border-color: var(--c-btn-action-border);
}
.btn-imperial-success:hover {
    background-color: rgb(80, 140, 80);
}

/* Variant: Danger (Leave Alliance etc.) */
.btn-imperial-danger {
    background-color: var(--c-btn-warn-bg);
    border-color: var(--c-btn-warn-border);
}
.btn-imperial-danger:hover {
    background-color: rgb(120, 50, 40);
}

/* Variant: Standard (Close buttons etc.) */
.btn-imperial-primary {
    background-color: var(--c-btn-chill-bg);
    border-color: var(--c-btn-chill-border);
}
.btn-imperial-primary:hover {
    background-color: rgb(180, 60, 50);
}

/* Shared tab navigation */
.window-tabs {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-border);
}

.window-tab {
    flex-grow: 1;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.12);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    color: var(--c-text-muted);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 0.1s;
}

.window-tab:hover {
    background-color: rgba(255, 255, 255, 0.28);
    color: var(--c-text-header);
}

.window-tab:active {
    background-color: rgba(0, 0, 0, 0.2);
}

.window-tab-active {
    background-color: rgba(0, 0, 0, 0.2);
    border-bottom-color: var(--c-text-highlight);
    color: var(--c-text-header);
}

/* Shared text link for navigation to players, cities and alliances */
.btn-entity-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--c-entity-link);
    -unity-font-style: bold;
    margin-top: 0;
    padding: 0;
    min-height: 0;
    height: auto;
    cursor: link;
    transition-duration: 0.1s;
}

.btn-entity-link:hover {
    color: var(--c-entity-link-hover);
    scale: 1.05;
}

.btn-entity-link:active {
    scale: 0.98;
}

.btn-entity-link:disabled {
    color: var(--c-text-muted);
    opacity: 0.55;
    scale: 1;
}

/* Shared text link for non-entity navigation such as auth scene changes */
.btn-text-link {
    min-height: 38px;
    margin-top: 7px;
    padding: 6px;
    color: var(--c-text-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 12px;
    cursor: link;
}

.btn-text-link:hover {
    color: var(--c-text-highlight);
}

.btn-text-link:disabled {
    color: var(--c-text-muted);
    opacity: 0.5;
}

/* ============================================================
   WINDOW STRUCTURE
   ============================================================ */
.screen-overlay {
    position: absolute; 
    width: 100%; 
    height: 100%;
    background-color: rgba(0, 0, 0, 0); 
    justify-content: center; 
    align-items: center;
}

.window-frame {
    position: absolute;
    background-color: var(--c-window-bg);
    background-image: var(--img-window-background);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(225, 214, 196, 0.97);
    border-radius: 7px;
    border-width: 4px;
    border-top-color: rgb(214, 177, 95);
    border-right-color: var(--c-window-edge);
    border-bottom-color: rgb(45, 34, 25);
    border-left-color: rgb(112, 82, 42);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.58);
    overflow: hidden;
}

.window-content-container {
    background-color: rgba(232, 222, 205, 0.38);
    border-top-width: 1px;
    border-top-color: rgba(255, 239, 196, 0.45);
}

/* ============================================================
   HEADER & TYPOGRAPHY
   ============================================================ */
.window-header {
    flex-direction: row; 
    height: 54px;
    background-color: var(--c-header-bg);
    background-image: var(--img-window-background);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(76, 61, 49, 0.96);
    border-top-width: 1px;
    border-top-color: rgba(241, 205, 126, 0.58);
    border-bottom-width: 4px;
    border-bottom-color: rgb(143, 103, 45);
    align-items: center; 
    justify-content: space-between;
    padding-left: 22px;
    padding-right: 9px;
    cursor: move-arrow;
}

.window-header-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-window-title);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2.4px;
    -unity-text-outline-width: 0.7px;
    -unity-text-outline-color: rgba(19, 13, 9, 0.95);
    text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.72);
}

.window-info-button {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 10px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Icons/Tooltip.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(239, 220, 174, 0.82);
    border-width: 0;
}

.window-info-button:hover {
    -unity-background-image-tint-color: rgb(255, 239, 196);
    scale: 1.05;
}

.window-info-button:active { scale: 0.95; }

.window-info-tooltip {
    position: absolute;
    left: 10px;
    top: 49px;
    width: 340px;
    padding: 12px 14px;
    background-color: rgb(236, 226, 207);
}

.window-info-tooltip__title {
    margin-bottom: 6px;
    color: var(--c-text-header);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
}

.window-info-tooltip__body {
    color: var(--c-text-body);
    -unity-font-definition: var(--font-body);
    font-size: 14px;
    white-space: normal;
}

/* --- THE CLOSE "X" BUTTON --- */
.window-close-btn {
    width: 34px;
    height: 34px;
    background-color: rgb(116, 39, 31);
    border-width: 2px;
    border-top-color: rgb(187, 91, 70);
    border-right-color: rgb(64, 24, 19);
    border-bottom-color: rgb(52, 19, 15);
    border-left-color: rgb(137, 53, 41);
    border-radius: 3px;
    color: white; 
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-right: 5px;
}

.window-close-btn:hover { 
    background-color: rgb(155, 51, 40);
    border-top-color: rgb(231, 139, 105);
    scale: 1.05;
}

.window-close-btn:active {
    background-color: rgb(120, 30, 20);
    scale: 0.95;
}

/* --- BODY TEXT --- */
.text-body {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-body);
    font-size: 15px;
    -unity-font-style: normal; 
}

/* ============================================================
   INPUTS (Generisk)
   ============================================================ */
.game-input {
    height: 40px;
    background-color: rgba(0, 0, 0, 0.08);
    border-width: 1px; 
    border-color: var(--c-border);
    border-radius: 6px;
    color: var(--c-text-body);
    -unity-font-definition: var(--font-body);
    -unity-font-style: normal; 
    font-size: 16px; 
    padding-left: 10px;
}

/* ============================================================
   UTILITY SIZES
   ============================================================ */
.size-small  { width: 400px; height: 350px; }
.size-medium { width: 550px; height: 500px; }
.size-large  { width: 800px; height: 600px; }
