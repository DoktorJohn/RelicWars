/* Assets/UI/Windows/WorldHexagonWindow/WorldHexagonWindow.uss */

/* ============================================================
   WINDOW LAYOUT
   ============================================================ */
.strategy-window {
    width: 550px;
    min-height: 450px;
}

.hexagon-body {
    padding: 20px;
    flex-grow: 1;
}

/* ============================================================
   INFO SECTION (Consistent with TownHall)
   ============================================================ */
.info-section {
    background-color: rgba(0, 0, 0, 0.05);
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 15px;
    border-width: 1px;
    border-color: var(--c-border);
}

.info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.2);
}

.info-row:last-child {
    border-bottom-width: 0;
}

.info-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-highlight);
    font-size: 13px;
    -unity-font-style: bold;
}

.info-value {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-body);
    font-size: 16px;
    -unity-font-style: bold;
}

/* ============================================================
   UNIT SELECTION LIST
   ============================================================ */
.section-title {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-header);
    font-size: 16px;
    margin-bottom: 10px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-border);
}

.unit-scroll-view {
    height: 250px;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.2);
    padding: 5px;
    margin-bottom: 15px;
}

/* --- UNIT ROW styling --- */
.unit-selection-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.1);
}

.unit-selection-row:hover {
    background-color: rgba(255, 255, 255, 0.4);
    border-color: var(--c-border);
}

.unit-name-label {
    -unity-font-definition: var(--font-header);
    color: var(--c-text-body);
    font-size: 14px;
    -unity-font-style: bold;
}

.unit-available-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    font-size: 11px;
}

/* ============================================================
   INPUT FIELD FIX (Gør teksten synlig)
   ============================================================ */
.unit-quantity-field {
    width: 80px;
    height: 30px;
    margin: 0;
    padding: 0;
}

/* Dette targeter selve tekstboksen indeni TextField komponenten */
.unit-quantity-field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0.1);
    border-color: var(--c-border);
    border-width: 1px;
    border-radius: 4px;
    color: var(--c-text-body);
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 2px 5px;
}

.unit-quantity-field .unity-base-text-field__input:focus {
    background-color: rgba(255, 255, 255, 0.8);
    border-color: var(--c-btn-chill-bg);
}

.hidden {
    display: none;
}