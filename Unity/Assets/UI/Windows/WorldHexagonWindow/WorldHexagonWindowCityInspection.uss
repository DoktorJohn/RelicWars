/* City inspection overrides layered on top of the shared window theme. */

.strategy-window {
    width: 560px;
    min-height: 360px;
    max-height: 720px;
}

.hexagon-body {
    padding: 20px;
    flex-grow: 1;
    gap: 12px;
}

.inspection-state-container {
    min-height: 96px;
}

.inspection-details {
    flex-direction: column;
}

.inspection-tabs {
    margin-bottom: 10px;
}

.inspection-tab {
    margin-left: 3px;
    margin-right: 3px;
}

.inspection-link-label {
    margin-left: 12px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-right;
}

.inspection-action-button {
    height: 30px;
    min-width: 112px;
    margin-top: 0;
    margin-left: 12px;
    padding: 3px 10px;
    font-size: 11px;
}

.hidden {
    display: none;
}

.march-orders-panel {
    flex-direction: column;
}

.march-summary {
    border-width: 1px;
    border-color: var(--c-border);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.04);
    padding: 8px 10px;
    margin-bottom: 8px;
}

.march-summary-row {
    flex-direction: row;
    min-height: 21px;
    align-items: center;
}

.march-summary-key,
.march-unit-header {
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    color: var(--c-text-muted);
    font-size: 11px;
}

.march-summary-key {
    width: 105px;
}

.march-summary-value {
    flex-grow: 1;
    -unity-font-definition: var(--font-body);
    color: var(--c-text-body);
    font-size: 13px;
}

.march-city-link {
    flex-grow: 1;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    font-size: 13px;
}

.march-unit-header,
.march-unit-row {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
}

.march-unit-header {
    height: 26px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-border);
}

.march-unit-scroll {
    height: 150px;
    border-bottom-width: 1px;
    border-bottom-color: var(--c-border);
}

.march-unit-row {
    min-height: 46px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.35);
}

.march-unit-name {
    width: 175px;
}

.march-unit-available {
    width: 85px;
    -unity-text-align: middle-center;
}

.march-unit-send {
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.march-unit-label {
    -unity-font-definition: var(--font-body);
    color: var(--c-text-body);
    font-size: 13px;
}

.march-unit-quantity {
    width: 86px;
    height: 34px;
    margin-right: 6px;
}

.march-unit-quantity .unity-base-text-field__input {
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
}

.march-max-button {
    width: 56px;
    height: 34px;
    min-height: 34px;
    margin: 0;
    padding: 2px 7px;
    font-size: 11px;
}

.march-empty {
    height: 100%;
    -unity-font-definition: var(--font-body);
    color: var(--c-text-muted);
    -unity-text-align: middle-center;
}

.march-total {
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    color: var(--c-text-header);
    -unity-text-align: middle-right;
    margin-top: 8px;
}

.march-status {
    min-height: 20px;
    margin-top: 4px;
    -unity-text-align: middle-center;
    color: var(--c-text-header);
}

.march-submit {
    width: 100%;
    margin-top: 4px;
}
