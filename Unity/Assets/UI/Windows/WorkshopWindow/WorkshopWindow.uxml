<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Windows/BarracksWindow/BarracksWindow.uss" />

    <ui:VisualElement name="Workshop-Window-Overlay" picking-mode="Ignore" class="screen-overlay">
        <ui:VisualElement name="Workshop-Window-MainContainer" class="window-frame size-large recruitment-window recruitment-command-window">
            <ui:VisualElement name="Workshop-Window-Header" class="window-header">
                <ui:Label name="Lbl-Title" class="window-header-label" text="WORKSHOP" />
                <ui:Button name="Header-Close-Button" class="window-close-btn" text="x" />
            </ui:VisualElement>

            <ui:ScrollView class="window-body recruitment-body-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                <ui:VisualElement class="tabs-wrapper">
                    <ui:ScrollView name="Tabs-Scroll-Container" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" class="tabs-scroll-view window-tabs" />
                </ui:VisualElement>
                <ui:VisualElement name="Detail-View-Container" class="detail-container">
                    <ui:VisualElement class="detail-split recruitment-panel">
                        <ui:VisualElement class="detail-left">
                            <ui:VisualElement class="unit-title-row">
                                <ui:Label name="Lbl-UnitName" class="unit-name-large" />
                                <ui:Label name="Lbl-OwnedCount" class="unit-owned-badge" />
                            </ui:VisualElement>
                            <ui:Label name="Lbl-LockRequirements" class="flavor-text locked-unit-copy" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-right">
                            <ui:VisualElement class="stats-grid">
                                <ui:VisualElement class="stat-column">
                                    <ui:VisualElement class="stat-row"><ui:Label text="POWER" class="stat-label"/><ui:Label name="Stat-Power" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="ARMOR" class="stat-label"/><ui:Label name="Stat-Armor" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="REACH" class="stat-label"/><ui:Label name="Stat-Reach" class="stat-value"/></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-column">
                                    <ui:VisualElement class="stat-row"><ui:Label text="DISCIPLINE" class="stat-label"/><ui:Label name="Stat-Discipline" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="MOBILITY" class="stat-label"/><ui:Label name="Stat-Mobility" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="LOOT CAPACITY" class="stat-label"/><ui:Label name="Stat-Loot" class="stat-value"/></ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-column stat-column-final">
                                    <ui:VisualElement class="stat-row"><ui:Label text="POPULATION" class="stat-label"/><ui:Label name="Stat-Pop" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="UNIT CAPACITY" class="stat-label"/><ui:Label name="Stat-Capacity" class="stat-value"/></ui:VisualElement>
                                    <ui:VisualElement class="stat-row"><ui:Label text="RECRUIT TIME" class="stat-label"/><ui:Label name="Stat-Time" class="stat-value stat-value-time"/></ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="action-box recruitment-panel">
                        <ui:VisualElement class="cost-row">
                            <ui:Label text="RECRUITMENT COST" class="section-label-small" />
                            <ui:VisualElement class="cost-resource"><ui:VisualElement class="cost-resource-icon cost-icon-wood"/><ui:Label name="Lbl-CostWood" class="cost-value"/></ui:VisualElement>
                            <ui:VisualElement class="cost-resource"><ui:VisualElement class="cost-resource-icon cost-icon-stone"/><ui:Label name="Lbl-CostStone" class="cost-value"/></ui:VisualElement>
                            <ui:VisualElement class="cost-resource"><ui:VisualElement class="cost-resource-icon cost-icon-metal"/><ui:Label name="Lbl-CostMetal" class="cost-value"/></ui:VisualElement>
                            <ui:VisualElement class="cost-resource"><ui:VisualElement class="cost-resource-icon cost-icon-population"/><ui:Label name="Lbl-CostPopulation" class="cost-value"/></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="recruitment-timing-row">
                            <ui:VisualElement class="recruitment-timing-field">
                                <ui:Label text="TOTAL RECRUITMENT TIME" class="recruitment-timing-label" />
                                <ui:Label name="Lbl-TotalRecruitmentTime" class="recruitment-timing-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="recruitment-timing-field recruitment-timing-field-final">
                                <ui:Label text="COMPLETION ETA" class="recruitment-timing-label" />
                                <ui:Label name="Lbl-RecruitmentEta" class="recruitment-timing-value recruitment-eta-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="recruitment-controls">
                            <ui:Label text="QUANTITY" class="quantity-label" />
                            <ui:VisualElement class="slider-container">
                                <ui:SliderInt name="Slider-Quantity" low-value="1" high-value="100" class="game-slider" />
                                <ui:IntegerField name="Input-Quantity" class="game-input game-input-number" />
                            </ui:VisualElement>
                            <ui:Button name="Btn-Recruit" class="btn-global-base btn-imperial-success recruit-execute-btn" text="RECRUIT 0 UNITS" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Queue-Section" class="queue-section recruitment-panel">
                    <ui:Label name="Queue-Header-Label" text="RECRUITMENT QUEUE (0/5)" class="section-label queue-header-label" />
                    <ui:ScrollView name="Recruitment-Queue-List" class="queue-scroll-view" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
