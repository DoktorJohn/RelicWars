/* ResearchWindow.uss */

.research-main-container {
    width: 900px;
    height: 700px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* TABS */
.research-tab-container {
    flex-direction: row;
    height: 45px;
    background-color: rgba(0, 0, 0, 0.1);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
}

.research-tab-button {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    color: #443322;
    -unity-font-style: bold;
    font-size: 14px;
}

.research-tab-button-active {
    background-color: rgba(0, 0, 0, 0.15);
    color: #2B1B10;
    border-bottom-width: 3px;
    border-bottom-color: #8B4513;
}

/* STATS BAR */
.research-stats-bar {
    height: 50px;
    background-color: rgba(0, 0, 0, 0.05);
    justify-content: center;
    padding: 0 25px;
    flex-shrink: 0;
}

.points-display { flex-direction: row; align-items: center; }
.points-prefix { color: #2B1B10; -unity-font-style: bold; font-size: 13px; margin-left: 10px; }
.points-value { color: #8B4513; font-size: 18px; -unity-font-style: bold; margin-left: 8px; }

/* GRID CONTAINER & BODY */
.research-content-body {
    flex-grow: 1;
    flex-basis: 0; /* Tvinger containeren til at holde sig inden for rammerne */
    min-height: 0; /* Forhindrer overflow */
    overflow: hidden;
    padding: 0; 
}

.research-scroll-view {
    flex-grow: 1;
}

.research-tree-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 20px; 
    padding-bottom: 40px;
}

.research-node {
    width: 190px;
    height: 110px;
    margin: 8px;
    background-color: rgba(0, 0, 0, 0.06);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 10px;
    justify-content: space-between;
}

.node-title { height: 34px; flex-shrink: 0; color: #2B1B10; -unity-font-style: bold; font-size: 13px; -unity-text-align: middle-center; border-bottom-width: 1px; border-bottom-color: rgba(0,0,0,0.1); padding-bottom: 2px; white-space: normal; overflow: hidden; }
.node-description { color: #443322; font-size: 10px; white-space: normal; -unity-text-align: middle-center; margin-top: 2px; }

.node-cost-row { flex-direction: row; justify-content: space-between; align-items: center; }
.node-cost-label { color: #8B4513; -unity-font-style: bold; font-size: 11px; }

.node-status-text-done { color: #006400; -unity-font-style: bold; font-size: 11px; }
.node-status-text-locked { color: #777; -unity-font-style: bold; font-size: 11px; }

/* KNAPPER */
.node-start-button {
    height: 24px;
    font-size: 10px;
    padding: 0 10px;
    margin-top: 0;
}

.node-button-locked {
    height: 24px;
    font-size: 10px;
    padding: 0 10px;
    margin-top: 0;
    background-color: rgba(0, 0, 0, 0.2);
    border-color: rgba(0, 0, 0, 0.3);
    color: #888;
}

.node-completed { border-color: #006400; background-color: rgba(0, 100, 0, 0.05); }
.node-locked { opacity: 0.5; }

/* ACTIVE RESEARCH FOOTER */
.active-research-footer {
    min-height: 96px;
    background-color: var(--c-window-bg);
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 25px 16px 25px;
    flex-shrink: 0; 
    border-top-width: 2px;
    border-top-color: var(--c-border);
}

.active-label-hint { color: var(--c-text-muted); font-size: 11px; }
.active-research-title { color: var(--c-text-header); font-size: 15px; -unity-font-style: bold; }
.active-timer-text { color: var(--c-btn-action-bg); font-size: 18px; -unity-font-style: bold; }
.active-research-summary { flex-direction: row; align-items: center; }
.active-research-copy { margin-left: 15px; }
.active-research-actions { align-items: flex-end; }
.cancel-research-button { height: 35px; font-size: 12px; margin-bottom: 0; }

.research-lock-tooltip {
    position: absolute;
    width: 280px;
    padding: 0;
    background-color: var(--c-window-bg);
    flex-direction: column;
    display: none;
    z-index: 999;
}

.research-lock-tooltip-header {
    height: 38px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    background-color: var(--c-header-bg);
    border-bottom-width: 2px;
    border-bottom-color: var(--c-border);
}

.research-lock-tooltip-title {
    color: var(--c-text-header);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.research-lock-tooltip-body {
    padding: 12px 14px 14px 14px;
    color: var(--c-text-body);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: normal;
}
