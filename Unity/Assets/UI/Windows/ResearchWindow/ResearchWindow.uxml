<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="ResearchWindow.uss" />

    <ui:VisualElement name="Research-Window-Overlay" picking-mode="Ignore" class="screen-overlay">
        <ui:VisualElement name="Research-Window-MainContainer" class="window-frame research-main-container">
            
            <ui:VisualElement name="Research-Window-Header" class="window-header">
                <ui:Label text="RESEARCH" class="window-header-label" />
                <ui:Button name="Header-Close-Button" class="window-close-btn" text="x" />
            </ui:VisualElement>

            <ui:VisualElement class="research-tab-container">
                <ui:Button name="Tab-Economy" text="ECONOMY" class="research-tab-button" />
                <ui:Button name="Tab-War" text="WAR" class="research-tab-button" />
                <ui:Button name="Tab-Utility" text="UTILITY" class="research-tab-button" />
            </ui:VisualElement>

            <ui:VisualElement class="research-stats-bar">
                <ui:VisualElement class="points-display">
                    <ui:VisualElement class="side-bar-icon-base icon-research" style="width: 24px; height: 24px;" />
                    <ui:Label text="RESEARCH POWER:" class="points-prefix" />
                    <ui:Label name="Research-Power-Amount" text="" class="points-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="Research-Requirement-Notice" class="research-requirement-notice">
                <ui:Label name="Research-Requirement-Notice-Label" text="" class="research-requirement-notice-label" />
            </ui:VisualElement>

            <ui:VisualElement class="research-content-body">
                <ui:ScrollView class="research-scroll-view">
                    <ui:VisualElement name="Research-Tree-Container" class="research-tree-grid" />
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="Active-Research-Panel" class="active-research-footer">
                <ui:VisualElement class="active-research-summary">
                    <ui:VisualElement class="loading-spinner" />
                    <ui:VisualElement class="active-research-copy">
                        <ui:Label text="CURRENTLY RESEARCHING:" class="active-label-hint" />
                        <ui:Label name="Active-Research-Name" text="" class="active-research-title" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="active-research-actions">
                    <ui:Label name="Active-Research-Timer" text="" class="active-timer-text" />
                    <ui:Button name="Button-Cancel-Research" text="" class="btn-global-base btn-imperial-danger cancel-research-button" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="Research-Lock-Tooltip" class="window-frame floating-window-frame research-lock-tooltip" picking-mode="Ignore">
            <ui:VisualElement class="research-lock-tooltip-header">
                <ui:Label text="UNLOCKED BY" class="research-lock-tooltip-title" />
            </ui:VisualElement>
            <ui:Label name="Research-Lock-Tooltip-Body" text="" class="text-body research-lock-tooltip-body" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
