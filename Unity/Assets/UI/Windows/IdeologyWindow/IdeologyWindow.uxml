<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="IdeologyWindow.uss" />

    <ui:VisualElement name="Ideology-Window-Overlay" picking-mode="Ignore" class="screen-overlay">
        <ui:VisualElement name="Ideology-Window-MainContainer" class="window-frame size-large" style="width: 875px; height: 675px;">

            <ui:VisualElement name="Ideology-Window-Header" class="window-header">
                <ui:Label class="window-header-label" text="IDEOLOGY" />
                <ui:Button name="Header-Close-Button" class="window-close-btn" text="×" />
            </ui:VisualElement>

            <ui:VisualElement class="window-body">

                <ui:VisualElement class="overview-section">
                    <ui:VisualElement class="overview-left">
                        <ui:Label name="Lbl-IdeologyName" class="ideology-title" text="" />
                        <ui:Label name="Lbl-IdeologyDescription" class="ideology-description" text="" />
                    </ui:VisualElement>

                    <ui:VisualElement class="overview-right">
                        <ui:Label class="points-title" text="IDEOLOGY POINTS" />
                        <ui:Label name="Lbl-AvailablePoints" class="points-value" text="" />
                        <ui:Label name="Lbl-PointsProduction" class="points-production" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label text="AVAILABLE FOCUSES" class="points-title" style="margin-bottom: 8px;" />
                
                <ui:VisualElement name="Focus-Grid-Container" class="focus-grid" />

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
