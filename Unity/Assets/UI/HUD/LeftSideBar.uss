/* Assets/UI/HUD/LeftSideBar.uss */

.side-bar-main-container {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 184px;
    padding-top: 112px;
    padding-right: 10px;
    padding-bottom: 12px;
    padding-left: 10px;
    align-items: stretch;
    background-color: rgb(29, 31, 33);
    background-image: var(--img-window-background);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(44, 43, 41, 0.96);
    border-right-width: 3px;
    border-right-color: rgb(126, 94, 43);
    border-bottom-width: 1px;
    border-bottom-color: rgb(55, 43, 31);
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.side-bar-button-container {
    width: 100%;
    height: 38px;
    margin-bottom: 2px;
    padding-right: 8px;
    padding-left: 9px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 15, 0.18);
    border-left-width: 2px;
    border-left-color: rgba(205, 166, 88, 0.28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(8, 8, 8, 0.58);
    border-radius: 2px;
    cursor: link;
    overflow: hidden;
    transition-property: translate;
    transition-duration: 0.12s;
}

.side-bar-command-button {
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-right: 8px;
    padding-left: 9px;
    justify-content: flex-start;
    border-top-width: 0;
    border-right-width: 0;
}

.side-bar-command-button:hover,
.side-bar-command-button:active {
    border-top-width: 0;
    border-right-width: 0;
}

.side-bar-button-container:hover {
    translate: 3px 0;
    background-color: rgba(132, 96, 42, 0.22);
    border-left-color: rgb(205, 166, 88);
}

.side-bar-button-container:active {
    translate: 1px 0;
}

.side-bar-icon-base {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(224, 215, 196);
}

.side-bar-button-container:hover .side-bar-icon-base {
    -unity-background-image-tint-color: white;
}

.icon-overview { background-image: url('project://database/Assets/UI/Icons/City.png'); }
.icon-dailies { background-image: url('project://database/Assets/UI/Icons/present.png'); }
.icon-starter-quest { background-image: url('project://database/Assets/UI/Icons/Quest.png'); }
.icon-profile { background-image: url('project://database/Assets/UI/Icons/PlayerIcon.png'); }
.icon-alliance { background-image: url('project://database/Assets/UI/Icons/AllianceIcon.png'); }
.icon-rankings { background-image: url('project://database/Assets/UI/Icons/RankingIcon.png'); }
.icon-research-sidebar { background-image: url('project://database/Assets/UI/Icons/ResearchIcon.png'); }
.icon-inbox { background-image: url('project://database/Assets/UI/Icons/Message.png'); }
.icon-reports { background-image: url('project://database/Assets/UI/Icons/Report.png'); }
.icon-bug-report { background-image: url('project://database/Assets/UI/Icons/Bug.png'); }

.side-bar-label {
    margin-left: 10px;
    color: rgb(226, 219, 204);
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 0.7px;
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    flex-grow: 1;
    overflow: hidden;
    white-space: nowrap;
}

.side-bar-label-dailies {
    color: rgb(205, 166, 88);
}

.notification-dot {
    position: absolute;
    right: 5px;
    top: 4px;
    min-width: 18px;
    height: 18px;
    padding-right: 4px;
    padding-left: 4px;
    background-color: rgb(146, 39, 31);
    border-width: 1px;
    border-color: rgb(225, 185, 100);
    border-radius: 9px;
    color: white;
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    font-size: 9px;
    -unity-text-align: middle-center;
    display: none;
}
