/* Assets/UI/HUD/UnitStackIdeology.uss */

.right-side-bar-main-container {
    position: absolute;
    top: 516px;
    bottom: 0;
    left: 0;
    width: 184px;
    min-height: 100px;
    padding: 0 10px 12px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
}

.city-command-city-divider {
    width: 100%;
    height: 2px;
    margin-bottom: 12px;
    flex-shrink: 0;
    background-color: rgb(178, 139, 68);
}

.city-command-eyebrow,
.city-command-section-title {
    color: rgb(178, 139, 68);
    -unity-font-definition: var(--font-header);
    -unity-font-style: bold;
    font-size: 9px;
    letter-spacing: 0.8px;
}

.city-command-eyebrow {
    width: 100%;
    margin-bottom: 7px;
    font-size: 12px;
    -unity-text-align: middle-center;
}
.city-command-section-title { margin-bottom: 5px; color: rgb(191, 181, 160); }

.city-command-button {
    width: 100%;
    height: 38px;
    padding-right: 8px;
    padding-left: 9px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 15, 0.18);
    border-left-width: 2px;
    border-left-color: rgba(205, 166, 88, 0.28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(8, 8, 8, 0.58);
    border-radius: 2px;
    cursor: link;
    transition-property: translate;
    transition-duration: 0.12s;
}

.city-command-button:hover { translate: 3px 0; background-color: rgba(132, 96, 42, 0.3); border-left-color: rgb(205, 166, 88); }
.city-command-button:active { translate: 1px 0; background-color: rgba(91, 34, 28, 0.45); }
.city-command-button-icon { width: 23px; height: 23px; margin-right: 9px; -unity-background-scale-mode: scale-to-fit; }
.city-command-button-label { color: rgb(226, 219, 204); -unity-font-definition: var(--font-body); -unity-font-style: bold; font-size: 11px; letter-spacing: 0.7px; }
.icon-ideology { background-image: url('project://database/Assets/UI/Icons/ideology.png'); }

.city-command-separator { height: 1px; margin-top: 11px; margin-bottom: 9px; flex-shrink: 0; background-color: rgba(205, 166, 88, 0.38); }
.city-unit-list { flex-grow: 1; min-height: 42px; }
.city-unit-list #unity-content-viewport,
.city-unit-list #unity-content-container { width: 100%; }
.city-unit-list Scroller { display: none; }

.city-unit-row {
    width: 100%;
    min-height: 30px;
    margin-bottom: 3px;
    padding-right: 7px;
    padding-left: 7px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 15, 0.2);
    border-left-width: 2px;
    border-left-color: rgba(205, 166, 88, 0.28);
    border-bottom-width: 1px;
    border-bottom-color: rgba(8, 8, 8, 0.5);
}

.city-unit-row:hover { background-color: rgba(132, 96, 42, 0.16); border-left-color: rgb(205, 166, 88); }
.city-unit-row-marker { display: none; }
.city-unit-row-name { min-width: 0; flex-grow: 1; color: rgb(215, 208, 195); -unity-font-definition: var(--font-body); font-size: 10px; overflow: hidden; white-space: nowrap; }
.city-unit-row-quantity { margin-left: 5px; color: var(--c-value-total-on-dark); -unity-font-definition: var(--font-body); -unity-font-style: bold; font-size: 11px; -unity-text-align: middle-right; }
.city-unit-list-empty { padding-top: 9px; color: rgb(145, 140, 132); -unity-font-definition: var(--font-body); -unity-font-style: italic; font-size: 10px; -unity-text-align: upper-center; }
