.unit-label-container {
    align-items: center;
    justify-content: center;
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
}

.unit-owner-bar {
    background-color: rgba(80, 0, 0, 0.9); /* Deep Red/Maroon */
    border-width: 0.25px;
    border-color: rgb(255, 255, 255);
    border-radius: 4px; /* Lidt skarpere hjørner end byen */
    padding: 2px 8px;
    min-width: 50px;
    align-items: center;
    justify-content: center;
}

.unit-owner-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 7px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.unit-strength-badge {
    background-color: rgba(120, 0, 0, 0.9);
    border-width: 0.5px;
    border-color: rgb(255, 255, 255);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    
    margin-bottom: -1px;
    padding: 0px 6px;
    height: 12.5px;
    min-width: 40px;
    
    align-items: center;
    justify-content: center;
}

.unit-strength-text {
    color: rgb(255, 255, 255);
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    
    margin: 0;
    padding: 0;
}