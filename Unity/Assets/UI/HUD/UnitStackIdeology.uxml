<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Windows/WindowTheme.uss" />
    <ui:Style src="project://database/Assets/UI/HUD/UnitStackIdeology.uss" />
    <ui:Style src="project://database/Assets/UI/Windows/ResponsiveLayout.uss" />
    
    <ui:VisualElement name="HUD-Bottom-Container" class="right-side-bar-main-container city-command-panel">
        <ui:VisualElement class="city-command-city-divider" />
        <ui:Label name="City-Command-CurrentCity-Label" text="" class="city-command-eyebrow" />

        <ui:VisualElement name="Button-Enact-Focuses" class="city-command-button">
            <ui:VisualElement class="city-command-button-icon icon-ideology" />
            <ui:Label text="FOCUSES" class="city-command-button-label" />
        </ui:VisualElement>

        <ui:VisualElement class="city-command-separator" />
        <ui:Label text="STATIONED UNITS" class="city-command-section-title" />
        <ui:ScrollView name="Container-Unit-Cards"
            class="troop-list-scrollview city-unit-list"
            mode="Vertical"
            show-horizontal-scroller="Never" 
            show-vertical-scroller="Never" 
            horizontal-scroller-visibility="Hidden" 
            vertical-scroller-visibility="Hidden" />
        
    </ui:VisualElement>
</ui:UXML>
