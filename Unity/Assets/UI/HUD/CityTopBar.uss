/* Assets/UI/HUD/CityTopBar.uss */

.city-top-bar-main-container {
    --c-hud-bg-dark: rgb(35, 31, 28);
    --c-hud-border-gold: rgb(165, 125, 50);
    --c-hud-text-light: rgb(235, 230, 220);
    
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    flex-direction: row;
    align-items: flex-start;
    padding-left: 0;
    padding-right: 20px;

    background-color: var(--c-hud-bg-dark);
    background-image: url('project://database/Assets/UI/TopBarHUD.jpg');
    -unity-background-scale-mode: scale-and-crop;
    background-position: center;
    -unity-background-image-tint-color: rgba(120, 120, 120, 0.3);

    border-bottom-width: 5px;
    border-bottom-color: var(--c-hud-border-gold);
    overflow: visible; 
}

/* =======================================================
   TIME SECTION
   ======================================================= */
.city-top-bar-time-section {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 120px; 
    margin-left: 140px; /* Sikrer at den ikke ligger under den store kort-knap i venstre hjrne */
    border-right-width: 1px;
    border-right-color: rgba(165, 125, 50, 0.3); /* Let guld-linje for at adskille uret */
}

.city-time-header {
    color: var(--c-hud-border-gold);
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: -2px;
}

.city-time-value {
    color: var(--c-hud-text-light);
    font-size: 16px;
    -unity-font-style: bold;
}


/* =======================================================
   RESOURCES SECTION
   ======================================================= */
.city-top-bar-resource-section-right {
    flex-direction: row;
    align-items: flex-start;
    height: 100%;
    flex-grow: 1;
    justify-content: flex-end;
    overflow: visible;
}

.city-resource-group {
    flex-direction: row;
    align-items: center;
    width: 140px; /* GET FRA 120px for at give mere luft mellem blokkene */
    height: 100%;
    justify-content: center;
    overflow: visible;
    flex-shrink: 0; 
}

.city-resource-icon-container {
    width: 40px;
    height: 40px;
    justify-content: center;
    align-items: center;
    overflow: visible;
    flex-shrink: 0;
}

.city-resource-icon-base {
    width: 40px; 
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.city-warehouse-capacity-bar {
    position: absolute;
    width: 48px;
    height: 48px;
    top: -4px;
    left: -7px; 
}

.icon-wood { background-image: url('project://database/Assets/UI/Icons/wood.png'); }
.icon-stone { background-image: url('project://database/Assets/UI/Icons/stone.png'); }
.icon-metal { background-image: url('project://database/Assets/UI/Icons/metal.png'); }
.icon-silver { background-image: url('project://database/Assets/UI/Icons/silver.png'); }
.icon-population { background-image: url('project://database/Assets/UI/Icons/population.png'); }
.icon-research { background-image: url('project://database/Assets/UI/Icons/research.png'); }
.icon-ideology { background-image: url('project://database/Assets/UI/Icons/ideology.png'); }

.city-resource-label-amount {
    color: var(--c-hud-text-light);
    -unity-font-definition: url("project://database/Assets/TextMesh Pro/Fonts/Roboto.asset");
    -unity-font-style: bold;
    font-size: 16px; 
    margin-left: 10px; /* GET for at trkke tallet lidt vk fra buens hjre kant */
    width: 85px; /* GET FRA 70px for at tillade store tal uden at de presses */
    -unity-text-align: middle-left;
    overflow: hidden; 
    white-space: nowrap;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.8);
}

/* =======================================================
   MAP BUTTON
   ======================================================= */
.city-top-bar-map-button {
    position: absolute;
    top: -5px;
    left: 5px;
    width: 120px;
    height: 120px;
    background-image: url('project://database/Assets/UI/Icons/MapIcon.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    transition-duration: 0.15s;
    cursor: link;
}

.city-top-bar-map-button:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.city-top-bar-map-button:active {
    scale: 0.95;
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

/* =======================================================
   CITY SELECTOR
   ======================================================= */
.city-selector-section {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 100%;
    margin-left: 20px;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-left-color: rgba(165, 125, 50, 0.3);
    cursor: link;
    /* Allow overflow for dropdown */
    overflow: visible;
}

.city-selector-label {
    width: 300px;
    height: 40px;
    color: var(--c-hud-text-light);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: link;
    margin: 0;
    padding: 0;
}

.city-selector-label:hover {
    color: var(--c-hud-border-gold);
}

.city-selector-rename-input {
    width: 300px;
    height: 40px; 
    font-size: 16px; 
    -unity-font-definition: var(--font-body);
    margin: 0;
    padding: 0;
}

/* Fix for inner input field styling */
.city-selector-rename-input > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.5);
    color: var(--c-hud-text-light);
    border-width: 1px;
    border-color: var(--c-hud-border-gold);
    border-radius: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    -unity-text-align: middle-center;
}

.city-selector-arrow {
    width: 30px;
    height: 40px;
    background-color: transparent;
    border-width: 0;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 24px;
    cursor: link;
    margin-left: 5px;
    margin-right: 5px;
    -unity-text-align: middle-center;
}

.city-selector-arrow:hover {
    color: rgb(255, 255, 255);
    scale: 1.1;
}

.city-selector-arrow:active {
    scale: 0.95;
    color: rgb(200, 200, 200);
}

.city-selector-arrow:disabled {
    color: rgba(100, 100, 100, 0.5);
    cursor: default;
}

.city-selector-dropdown-container {
    position: absolute;
    top: 50px; /* HUD height */
    left: 0;
    width: 220px;
    max-height: 300px;
    background-color: var(--c-hud-bg-dark);
    border-width: 2px;
    border-color: var(--c-hud-border-gold);
    border-radius: 4px;
    flex-direction: column;
}

.city-selector-item {
    padding: 10px;
    color: var(--c-hud-text-light);
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.3);
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 14px;
    cursor: link;
}

.city-selector-item:hover {
    background-color: rgba(165, 125, 50, 0.2);
}