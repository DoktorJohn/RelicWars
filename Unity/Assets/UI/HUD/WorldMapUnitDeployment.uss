.UnitDeployment-sidebar-window {
    position: absolute;
    right: 20px;
    top: 120px;
    /* FIX 1: Brug bottom i stedet for max-height for at få det til at fylde skærmen i højden */
    bottom: 50px; 
    width: 320px;
    border-radius: 8px;
    transition-duration: 0.2s;
    /* Sikrer at vi ikke ser indhold der "stikker ud" under transition */
    overflow: hidden; 
}

/* FIX 2: Når vinduet er minimeret, fjerner vi body helt fra renderingen */
.UnitDeployment-sidebar-window.minimized {
    /* Vi lader højden styres af headeren (ca 50px) og fjerner 'bottom' bindingen */
    bottom: auto;
    height: 50px;
}

.UnitDeployment-sidebar-window.minimized .UnitDeployment-body {
    display: none;
}

.UnitDeployment-header-clickable:hover {
    background-color: rgba(255, 255, 255, 0.1);
    cursor: link;
}

.sidebar-header-text {
    font-size: 18px;
    letter-spacing: 1px;
}

.btn-imperial-danger {
    height: 32px; /* Lidt mindre end standard vindues-knapper for at passe i sidebaren */
    font-size: 11px;
    margin-bottom: 5px;
}

.btn-imperial-danger:hover {
    background-color: rgb(150, 40, 30);
    border-color: rgb(200, 50, 40);
}

.UnitDeployment-body {
    flex-grow: 1; /* Lad body fylde resten af vinduet ud */
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.15);
}

.UnitDeployment-sidebar-scrollview {
    flex-grow: 1;
}

/* --- Entry Styling --- */
.UnitDeployment-entry-container {
    background-color: rgba(255, 255, 255, 0.05);
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--c-border);
    border-radius: 4px;
}

.UnitDeployment-entry-header {
    flex-direction: row;
    padding: 10px;
    background-color: var(--c-header-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-border);
}

.UnitDeployment-name-label {
    color: var(--c-text-header);
    flex-grow: 1;
    -unity-font-style: bold;
    font-size: 13px;
}

.UnitDeployment-size-badge {
    color: var(--c-text-highlight);
    font-size: 11px;
    -unity-font-style: bold;
}

/* --- Details Section --- */
.UnitDeployment-details-container {
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.2);
    display: none;
}

.UnitDeployment-details-container.expanded {
    display: flex;
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(165, 125, 50, 0.15);
    padding-bottom: 2px;
}

.detail-label {
    color: var(--c-text-muted);
    font-size: 10px;
    -unity-font-style: bold;
}

.detail-value {
    color: var(--c-text-body);
    font-size: 11px;
}

.unit-stack-list {
    margin-top: 10px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(165, 125, 50, 0.2);
}

.unit-stack-row {
    flex-direction: row;
    justify-content: space-between;
}

.unit-stack-text {
    color: var(--c-text-body);
    font-size: 11px;
}